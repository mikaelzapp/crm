# Copie para .env. Nunca publique o arquivo .env.
# POSTGRES_PASSWORD deve usar caracteres seguros para URL (ex.: 48 caracteres hex).
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
ADMIN_EMAIL=admin@example.local
# Mínimo 12 caracteres; .env suporta valores entre aspas simples.
ADMIN_PASSWORD=CHANGE_ME_ADMIN
# Gere 32 bytes em hexadecimal. Perder esta chave impede decifrar tokens salvos.
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION
APP_URL=http://localhost:3000
BIND_ADDRESS=127.0.0.1
PORT=3000
# Para npm fora do Docker, as URLs precisam apontar aos serviços locais.
# Compose substitui DATABASE_URL e REDIS_URL para os nomes internos dos serviços.
DATABASE_URL=postgresql://crm:CHANGE_ME_POSTGRES@127.0.0.1:5432/crm?schema=public
REDIS_URL=redis://127.0.0.1:6379
# mock nunca realiza envio na Meta. Selecione live apenas após configurar a conta.
WHATSAPP_MODE=mock
# Seed opcional: dois números e um modelo de teste, sem envio externo.
MOCK_WHATSAPP_ENABLED=true
META_API_VERSION=v23.0
META_APP_SECRET=
META_VERIFY_TOKEN=

# IA opcional. O modelo é escolhido por agente na interface; não há pull automático.
# Next/worker executados no host:
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Dentro do Compose: serviço do perfil ollama. Para Ollama no host, use
# http://host.docker.internal:11434. Não use 127.0.0.1 para alcançar outro contêiner.
OLLAMA_DOCKER_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT_MS=60000
OLLAMA_KEEP_ALIVE=5m
# Somente se o endpoint Ollama estiver atrás de proxy protegido; nunca no frontend.
OLLAMA_API_KEY=
# Fixe uma tag/digest após validar sua instalação, em vez de atualizar implicitamente.
OLLAMA_IMAGE=ollama/ollama:latest
